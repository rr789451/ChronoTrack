{
  "expo": {
    "name": "chronotrack",
    "slug": "chronotrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon.jpg",
    "scheme": "chronotrack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rohit.chronotrack"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-icon.jpg",
        "backgroundColor": "#363433"
      },
      "package": "com.rohit.timerapp",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/splash-icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#363433"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "983fda18-1dd9-4752-889f-3b121d1783b4"
      }
    }
  }
}
